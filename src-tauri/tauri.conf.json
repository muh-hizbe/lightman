{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightman",
  "version": "1.2.2",
  "identifier": "com.lightman.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lightman",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QzkzMzM2MjFBNzZBMTQKUldRVWFxY2hOalBKVkh3TXlKL1pqMjViS2UrZDdhLzl2a0xySXVETGlqMlZLU1NBdURlNUtYMVUK",
      "endpoints": [
        "https://github.com/muh-hizbe/lightman/releases/latest/download/latest.json"
      ]
    }
  }
}
